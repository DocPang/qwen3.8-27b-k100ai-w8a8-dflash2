ninja_required_version = 1.3
cxx = c++
nvcc = /opt/dtk/bin/hipcc

cflags = -DTORCH_EXTENSION_NAME=q38_smallm_directlds_fused_gateup_v4 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /usr/local/lib/python3.10/dist-packages/torch/include -isystem /usr/local/lib/python3.10/dist-packages/torch/include/torch/csrc/api/include -isystem /usr/local/lib/python3.10/dist-packages/torch/include/THH -isystem /opt/dtk/include -isystem /usr/include/python3.10 -fPIC -std=c++17 -O3 -std=c++20
post_cflags = -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -DPYTORCH_DTK_VERSION=260400 -fPIC
cuda_cflags = -DWITH_HIP -DTORCH_EXTENSION_NAME=q38_smallm_directlds_fused_gateup_v4 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /usr/local/lib/python3.10/dist-packages/torch/include -isystem /usr/local/lib/python3.10/dist-packages/torch/include/torch/csrc/api/include -isystem /usr/local/lib/python3.10/dist-packages/torch/include/THH -isystem /opt/dtk/include -isystem /usr/include/python3.10 -O3 -std=c++20 -D__HIP_PLATFORM_AMD__=1 -DUSE_ROCM=1 -DHIPBLAS_V2 -DPYTORCH_DTK_VERSION=260400 -fPIC -DCUDA_HAS_FP16=1 -D__HIP_NO_HALF_OPERATORS__=1 -D__HIP_NO_HALF_CONVERSIONS__=1 -DHIP_ENABLE_WARP_SYNC_BUILTINS=1 -std=c++17 --offload-arch=gfx928 -fno-gpu-rdc -O3 -std=c++20 -fno-gpu-rdc --offload-arch=gfx928
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/usr/local/lib/python3.10/dist-packages/torch/lib -lc10 -lc10_hip -ltorch_cpu -ltorch_hip -ltorch -ltorch_python -L/opt/dtk/lib -lamdhip64

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build candidate_family_directlds_combo_fused_gateup_v4.cuda.o: cuda_compile /probe/candidate_family_directlds_combo_fused_gateup_v4.hip





build q38_smallm_directlds_fused_gateup_v4.so: link candidate_family_directlds_combo_fused_gateup_v4.cuda.o

default q38_smallm_directlds_fused_gateup_v4.so
